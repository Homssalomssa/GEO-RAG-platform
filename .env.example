# Geo-RAG Platform — Environment Configuration
#
# Copy this file to .env and customize for your environment.
# All values shown are the defaults if not set in .env.
#
# Documentation: See SETUP.md for detailed configuration guide
#

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================

# Base URL for Ollama API
# Local: http://localhost:11434
# Remote: http://remote-host:11434
OLLAMA_BASE_URL=http://localhost:11434

# Vision model name — must be pulled via `ollama pull VISION_MODEL`
# Recommended: llava:7b (local-only)
# Alternatives: qwen2.5-vl:1b (faster), llama2-vision (if available)
VISION_MODEL=llava:7b

# LLM (Language Model) for reasoning — must be pulled via `ollama pull LLM_MODEL`
# Recommended: gemma3:1b (fast, coherent)
# Alternatives: gemma2:9b (better quality, slower), mistral:latest (balanced)
LLM_MODEL=gemma3:1b

# =============================================================================
# LLM GENERATION PARAMETERS
# =============================================================================

# Temperature for LLM generation (0.0-1.0)
# 0.0 = deterministic, repetitive
# 0.3 = low (analytical, consistent)
# 0.7 = high (creative, varied)
# Default: 0.3 (for analysis consistency)
# LLM_TEMPERATURE=0.3

# Maximum tokens per LLM generation
# Higher = longer responses
# Default: 1024 (enough for thorough answers)
# LLM_MAX_TOKENS=1024

# Ollama request timeout (seconds)
# Vision models can be slow; don't set too low
# Default: 120 seconds
# OLLAMA_TIMEOUT=120

# =============================================================================
# RAG (RETRIEVAL-AUGMENTED GENERATION) CONFIGURATION
# =============================================================================

# ChromaDB persistent storage directory
# Where ingested knowledge is stored
# Default: ./chroma_db (relative to project directory)
# CHROMA_PERSIST_DIR=./chroma_db

# ChromaDB collection name
# All knowledge stored in this collection
# Default: geo_knowledge
# CHROMA_COLLECTION_NAME=geo_knowledge

# Embedding model for vector search
# Uses sentence-transformers (runs locally)
# Don't change unless you have a specific reason
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Semantic search — top-k results returned
# Default: 5
# SEMANTIC_TOP_K=5

# Keyword search (BM25) — top-k results returned
# Default: 3
# KEYWORD_TOP_K=3

# Reciprocal Rank Fusion constant for hybrid ranking
# Higher value (60) favors documents in both lists
# Adjust if merging seems off
# RRF_K=60

# =============================================================================
# IMAGE UPLOAD CONFIGURATION
# =============================================================================

# Maximum image size in MB
# Default: 10 MB
# MAX_IMAGE_SIZE_MB=10

# Supported image MIME types (do not change)
# SUPPORTED_IMAGE_TYPES=image/jpeg,image/png,image/tiff,image/webp

# =============================================================================
# DEVELOPMENT / DEBUG
# =============================================================================

# Set to 'true' to enable debug logging (more verbose)
# DEBUG=false

# =============================================================================
# EXAMPLES
# =============================================================================

# Example 1: Local setup (recommended for development)
# OLLAMA_BASE_URL=http://localhost:11434
# VISION_MODEL=llava:7b
# LLM_MODEL=gemma3:1b

# Example 2: Remote Ollama on different host
# OLLAMA_BASE_URL=http://192.168.1.100:11434
# VISION_MODEL=llava:7b
# LLM_MODEL=gemma3:1b

# Example 3: Faster models (smaller, but less accurate)
# OLLAMA_BASE_URL=http://localhost:11434
# VISION_MODEL=qwen2.5-vl:1b
# LLM_MODEL=gemma2:2b

# Example 4: Production (stricter config)
# OLLAMA_BASE_URL=http://ollama-service:11434
# LLM_TEMPERATURE=0.1
# CHROMA_PERSIST_DIR=/var/lib/geo-rag/chroma_db
# MAX_IMAGE_SIZE_MB=50

# =============================================================================
# NOTES
#
# 1. All configuration parameters have sensible defaults in config.py
#    Only set them here if you need to override the defaults.
#
# 2. After modifying .env, restart the application:
#    python main.py
#
# 3. To verify configuration:
#    - Backend: curl http://localhost:8000/api/health | jq
#    - Ollama: curl http://OLLAMA_BASE_URL/api/tags | jq
#
# 4. For troubleshooting, see SETUP.md "Troubleshooting" section
#
# 5. Never commit .env to git. Use .gitignore:
#    echo ".env" >> .gitignore
#
