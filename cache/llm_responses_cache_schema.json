{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM Response Cache Schema",
  "description": "Cached LLM-generated answers and analysis traces",
  "type": "object",
  "required": ["job_id", "answer", "cached_at", "expires_at"],
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Unique job identifier"
    },
    "answer": {
      "type": "string",
      "description": "Generated answer text from LLM"
    },
    "analysis_trace": {
      "type": "object",
      "description": "Trace of analysis stages",
      "properties": {
        "vision_features": { "type": "object" },
        "spatial_context": { "type": "object" },
        "retrieved_documents": { "type": "array" },
        "llm_prompt": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "image_hash": { "type": "string" },
        "query": { "type": "string" },
        "mode": { "type": "string" },
        "processing_time_seconds": { "type": "number" }
      }
    },
    "cached_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiration timestamp (30 days from cached_at)"
    }
  }
}
